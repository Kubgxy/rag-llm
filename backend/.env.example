# Application
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS (เพิ่ม frontend URLs ที่อนุญาต)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Ollama
OLLAMA_HOST=http://localhost:11434
DEFAULT_LLM_MODEL=scb10x/typhoon2.5-qwen3-4b
ALTERNATIVE_LLM_MODEL=iapp/chinda-qwen3-4b
LLM_RUNTIME_DEVICE=cpu
# -1 = ให้ Ollama ตัดสินใจอัตโนมัติ, 0 = บังคับ CPU, >0 = จำนวน layers ที่ offload ไป GPU
OLLAMA_NUM_GPU=-1
LLM_NUM_CTX=2048
CPU_LLM_NUM_CTX=1024
CPU_LLM_NUM_PREDICT=256

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Storage
UPLOAD_DIR=uploaded_docs
CHROMA_PATH=./chroma_local_data
