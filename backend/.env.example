# Application
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS (เพิ่ม frontend URLs ที่อนุญาต)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# PostgreSQL + pgvector (Docker)
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragllm
DATABASE_URL_SYNC=postgresql+psycopg2://raguser:ragpass@localhost:5432/ragllm

# JWT Auth
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama
OLLAMA_HOST=http://localhost:11434
DEFAULT_LLM_MODEL=scb10x/typhoon2.5-qwen3-4b
ALTERNATIVE_LLM_MODEL=iapp/chinda-qwen3-4b
ACTION_LLM_MODEL=qwen2.5-coder:7b
LLM_RUNTIME_DEVICE=cpu
# -1 = ให้ Ollama ตัดสินใจอัตโนมัติ, 0 = บังคับ CPU, >0 = จำนวน layers ที่ offload ไป GPU
OLLAMA_NUM_GPU=-1
LLM_NUM_CTX=2048
CPU_LLM_NUM_CTX=1024
CPU_LLM_NUM_PREDICT=256

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Conversation Memory
CONVERSATION_MEMORY_LIMIT=15
CONVERSATION_MEMORY_MAX_TOKENS=4096

# Storage
UPLOAD_DIR=uploaded_docs

# Web Search
TAVILY_API_KEY=
